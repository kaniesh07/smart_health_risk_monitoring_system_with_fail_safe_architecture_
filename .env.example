# Copy to .env and fill in. docker compose reads .env automatically.

# -- Backend -------------------------------------------------------------
# Shared secret required in the X-API-Key header on every /api/* call.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty to disable auth (local development only).
API_KEY=

# Where the SQLite database lives. Point at a persistent disk in production.
# HEALTH_DB_PATH=/var/data/health.db

# Load the PhysioNet demo patients into an empty database on boot.
SEED_DEMO_DATA=true

# Seconds a device counts as "live" after its last reading.
LIVE_TIMEOUT_SECONDS=20

# Never enable in production (exposes the interactive debugger).
FLASK_DEBUG=0

# -- Dashboard -----------------------------------------------------------
# Public URL of the backend service, e.g. https://health-backend.onrender.com
BACKEND_URL=http://localhost:5000
